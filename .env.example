# Bind the bridge to loopback by default. Put a public HTTPS URL here only
# after placing a TLS reverse proxy or Secure MCP Tunnel in front of it.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_PUBLIC_BASE_URL=http://127.0.0.1:8787

# Separate credentials for the read-only and control MCP endpoints.
# Generate long random values; do not commit real values.
BRIDGE_INSPECT_TOKEN=replace-with-a-long-random-inspect-token
BRIDGE_CONTROL_TOKEN=replace-with-a-long-random-control-token

# Separate human approval channel. This is intentionally not an MCP token.
BRIDGE_HUMAN_APPROVAL_TOKEN=replace-with-a-long-random-human-token

# Set BRIDGE_AUTH_MODE=oauth or both before connecting ChatGPT through OAuth.
# Static tokens are convenient for local MCP Inspector checks.
BRIDGE_AUTH_MODE=both
BRIDGE_OAUTH_LOGIN_TOKEN=replace-with-a-long-random-oauth-login-token
BRIDGE_OAUTH_ENABLED=1

# Optional workspace boundary. Plans outside this directory are rejected.
# BRIDGE_WORKSPACE_ROOT=C:\\Users\\Administrator\\Documents\\global

# DSH ACP adapter. The child receives the normal DSH environment, including
# configured provider credentials, but the bridge never returns them in output.
DSH_COMMAND=dsh.cmd
DSH_PROFILE=acp
# Use read-only by default; write/execute plans then require DSH ACP escalation.
# Set workspace-write only when every approved task explicitly includes mutation.
DSH_PERMISSION_MODE=read-only
DSH_PERMISSION_TIMEOUT_MS=900000

# Persistent bridge state.
BRIDGE_DATA_DIR=./data
